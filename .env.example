# ─── Stripe ──────────────────────────────────────────────────────────
# Restricted read-only key. Generate one at:
#   Stripe Dashboard → Developers → API keys → Create restricted key
#   Permissions: Charges=Read, Customers=Read, Invoices=Read, Subscriptions=Read, Products=Read,
#   Checkout Sessions=Read (the /ads page)
STRIPE_KEY=rk_live_REPLACE_ME

# Second Stripe account (ThriveCart). Read-only restricted key with
# Charges=Read, Subscriptions=Read, Customers=Read, Products=Read. Adds
# ThriveCart sales to the dashboard and members page. Blank = skip it.
STRIPE_THRIVECART_KEY=

# TEMPORARY. Main account key with Payment Links=Write, Prices=Read,
# Products=Read, used only to create the tagged checkout links from the
# members page. Remove it once the links exist.
STRIPE_WRITE_KEY=

# ─── Meta Ads ────────────────────────────────────────────────────────
# Read-only token (ads_read) for ad account 796462494198580. Powers /ads
# (spend per ad set). Blank = /ads shows Stripe numbers only.
META_ACCESS_TOKEN=
# Optional Graph API version override (default v23.0).
META_API_VERSION=

# ─── Firebase Admin (server-side) ────────────────────────────────────
# Paste the entire contents of the service-account JSON file you downloaded
# from Firebase Console → Project Settings → Service accounts → Generate key.
# Must be one line (collapsed JSON). Quoted.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"REPLACE","..."}

# ─── Firebase Web (client-side, safe to expose) ──────────────────────
# Get these from Firebase Console → Project Settings → "Your apps" → Web app
FIREBASE_API_KEY=AIza_REPLACE_ME
FIREBASE_AUTH_DOMAIN=mr-vig-dashboard.firebaseapp.com
FIREBASE_PROJECT_ID=mr-vig-dashboard
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ─── Authorization ───────────────────────────────────────────────────
# Comma-separated allowlist of Google email addresses that may sign in.
ALLOWED_EMAILS=omar@example.com,client@example.com,ivana@example.com

# ─── Operational ─────────────────────────────────────────────────────
# Cron schedule (node-cron syntax). Default: top of every hour.
REFRESH_CRON=0 * * * *

# ─── Chat-with-data (OpenRouter) ─────────────────────────────────────
# Key from openrouter.ai. Powers the in-dashboard analytics chat.
OPENROUTER_KEY=sk-or-v1-REPLACE_ME
# Optional model override (default: anthropic/claude-3.5-sonnet)
CHAT_MODEL=anthropic/claude-3.5-sonnet

# Port. Railway sets this automatically; leave blank in production.
PORT=3000
